  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Save or confirm the main task.",
      "html": "<button class=\"ds-primary\">Save changes</button>",
      "css": ".ds-primary{font-family:Manrope,system-ui,sans-serif;font-size:16px;font-weight:700;border:1px solid var(--outline,#354151);border-radius:12px;min-height:48px;padding:10px 18px;display:inline-flex;align-items:center;justify-content:center;gap:10px;cursor:pointer;touch-action:manipulation;background:var(--cyan,#78dce8);color:#101e22;border-color:transparent}.ds-primary:hover{background:var(--cyan,#78dce8)}.ds-primary:focus-visible{outline:3px solid var(--cyan,#78dce8);outline-offset:3px}.ds-primary:disabled{opacity:.55;cursor:wait}"
    },
    {
      "name": "Quiet button",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Secondary action alongside the working content.",
      "html": "<button class=\"ds-quiet\">Undo</button>",
      "css": ".ds-quiet{font-family:Manrope,system-ui,sans-serif;font-size:16px;font-weight:700;border:1px solid var(--outline,#354151);border-radius:12px;min-height:48px;padding:10px 18px;display:inline-flex;align-items:center;justify-content:center;gap:10px;cursor:pointer;touch-action:manipulation;background:var(--surface,#1c222b);color:var(--ink,#f5f7fa)}.ds-quiet:hover{background:var(--surface-high,#252d38)}.ds-quiet:focus-visible{outline:3px solid var(--cyan,#78dce8);outline-offset:3px}.ds-quiet:disabled{opacity:.55;cursor:wait}"
    },
    {
      "name": "Danger button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Explicit destructive or replacement action.",
      "html": "<button class=\"ds-danger\">Delete page</button>",
      "css": ".ds-danger{font-family:Manrope,system-ui,sans-serif;font-size:16px;font-weight:700;border:1px solid var(--outline,#354151);border-radius:12px;min-height:48px;padding:10px 18px;display:inline-flex;align-items:center;justify-content:center;gap:10px;cursor:pointer;touch-action:manipulation;background:#39242b;color:var(--red,#ff8e93);border-color:#67404c}.ds-danger:hover{background:#39242b}.ds-danger:focus-visible{outline:3px solid var(--cyan,#78dce8);outline-offset:3px}.ds-danger:disabled{opacity:.55;cursor:wait}"
    },
    {
      "name": "Labeled field",
      "kind": "input",
      "refersTo": "input",
      "description": "A configured value with an ordinary text-entry fallback.",
      "html": "<label class=\"ds-field\">Page name<input value=\"Stream controls\" maxlength=\"30\"></label>",
      "css": ".ds-field{font-family:Manrope,system-ui,sans-serif;display:flex;flex-direction:column;gap:8px;font-size:13px;font-weight:700;color:var(--secondary,#b8c3d1);min-width:0}.ds-field input{font-family:Manrope,system-ui,sans-serif;background:#131922;border:1px solid var(--outline,#354151);border-radius:10px;min-height:48px;padding:11px 13px;color:var(--ink,#f5f7fa);font-size:15px;caret-color:var(--cyan,#78dce8)}.ds-field input::placeholder{color:var(--secondary,#b8c3d1);opacity:1}.ds-field input:focus-visible{outline:3px solid var(--cyan,#78dce8);outline-offset:3px}"
    },
    {
      "name": "Grouped desktop navigation",
      "kind": "nav",
      "refersTo": "navigation-current",
      "description": "Task group with one explicit current location.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Create\"><h2>Create</h2><button aria-current=\"page\">Board editor</button><button>Profiles</button><button>Ink &amp; notes</button></nav>",
      "css": ".ds-nav{font-family:Manrope,system-ui,sans-serif;width:192px;background:var(--surface,#1c222b);padding:12px;color:var(--ink,#f5f7fa)}.ds-nav h2{font-size:12px;font-weight:600;line-height:1.5;color:var(--secondary,#b8c3d1);margin:0 12px 6px}.ds-nav button{font-family:Manrope,system-ui,sans-serif;width:100%;display:flex;align-items:center;justify-content:flex-start;min-height:42px;padding:9px 12px;border:0;border-radius:8px;background:transparent;color:var(--ink,#f5f7fa);font-size:13px;font-weight:700;text-align:left;cursor:pointer}.ds-nav button:hover{background:var(--surface-high,#252d38)}.ds-nav button[aria-current=page]{background:var(--surface-high,#252d38);color:var(--cyan,#78dce8)}.ds-nav button:focus-visible{outline:3px solid var(--cyan,#78dce8);outline-offset:3px}.ds-nav button:disabled{opacity:.55;cursor:wait}"
    },
    {
      "name": "Status badge",
      "kind": "chip",
      "refersTo": "status-badge",
      "description": "Short supporting status, always expressed in words.",
      "html": "<span class=\"ds-badge\">Saved</span>",
      "css": ".ds-badge{font-family:Manrope,system-ui,sans-serif;display:inline-block;padding:5px 9px;border-radius:6px;background:var(--surface-high,#252d38);color:var(--secondary,#b8c3d1);font-size:12px}"
    },
    {
      "name": "Studio key",
      "kind": "button",
      "refersTo": "studio-key",
      "description": "Operational tablet key using the final studio treatment; full-pad density rules override dimensions.",
      "html": "<button class=\"ds-key\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z\"></path></svg><span>Open app</span></button>",
      "css": ".ds-key{font-family:Manrope,system-ui,sans-serif;border:1px solid var(--outline,#354151);background:var(--surface,#1c222b);border-radius:16px;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:8px;padding:12px 8px;color:var(--blue,#9ac9f5);min-height:78px;min-width:0;cursor:pointer;transition:background-color .12s ease-out,transform .12s ease-out,border-color .12s ease-out}.ds-key svg{width:clamp(32px,5vw,72px);height:clamp(32px,5vw,72px);max-width:60%;max-height:45%;min-height:22px;flex-shrink:1;fill:none;stroke:currentColor;stroke-width:1.65;stroke-linecap:round;stroke-linejoin:round}.ds-key span{color:var(--ink,#f5f7fa);font-size:clamp(13px,1.7vw,25px);font-weight:800;line-height:1.2;text-align:center;overflow-wrap:anywhere;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;max-height:2.4em;flex-shrink:0}.ds-key:hover{background:var(--surface-high,#252d38)}.ds-key:active{transform:scale(.965);background:#293943}.ds-key:focus-visible{outline:3px solid var(--cyan,#78dce8);outline-offset:3px}.ds-key:disabled{opacity:.55;cursor:wait}@media(prefers-reduced-motion:reduce){.ds-key{transition:none}}@media(min-width:1051px) and (min-height:651px){.ds-key span{font-size:clamp(16px,1.9vw,29px)}}@media(max-width:760px){.ds-key{padding:8px 6px;gap:6px}.ds-key svg{width:32px;height:32px}.ds-key span{font-size:13px}}"
    },
    {
      "name": "Selected preview key",
      "kind": "button",
      "refersTo": "editor-key",
      "description": "Editor selection; preview does not execute the action.",
      "html": "<button class=\"ds-editor-key\" aria-pressed=\"true\" aria-label=\"Edit Scene\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z\"></path></svg><span>Scene</span><small>Selected</small></button>",
      "css": ".ds-editor-key{font-family:Manrope,system-ui,sans-serif;width:100%;min-height:104px;border:1px solid var(--outline,#354151);border-radius:12px;background:var(--surface,#1c222b);color:var(--violet,#b7a0f9);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;padding:23px 9px 13px;overflow-wrap:anywhere;cursor:pointer}.ds-editor-key[aria-pressed=true]{outline:2px solid var(--cyan,#78dce8);outline-offset:1px}.ds-editor-key:hover{background:var(--surface-high,#252d38)}.ds-editor-key svg{width:32px;height:32px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.ds-editor-key>span{font-size:12px;line-height:1.35;font-weight:700;color:var(--ink,#f5f7fa)}.ds-editor-key>small{font-size:9px;color:var(--cyan,#78dce8)}.ds-editor-key:focus-visible{outline:3px solid var(--cyan,#78dce8);outline-offset:3px}.ds-editor-key:disabled{opacity:.55;cursor:wait}@media(prefers-reduced-motion:no-preference){.ds-editor-key{transition:background .12s ease-out,outline-color .12s ease-out}}"
    },
    {
      "name": "Pen tools and finger guard",
      "kind": "custom",
      "refersTo": "button-quiet",
      "description": "Visible selected tool and persistent labeled touch preference.",
      "html": "<div class=\"ds-pen-tools\" role=\"toolbar\" aria-label=\"Drawing tools\"><button aria-pressed=\"true\">Pen</button><button aria-pressed=\"false\">Eraser</button><label><input type=\"checkbox\" checked>Ignore fingers on canvas</label></div>",
      "css": ".ds-pen-tools{font-family:Manrope,system-ui,sans-serif;display:flex;align-items:center;flex-wrap:wrap;gap:12px 20px;padding:12px 0;border-top:1px solid var(--outline,#354151);border-bottom:1px solid var(--outline,#354151);color:var(--ink,#f5f7fa)}.ds-pen-tools button{font-family:Manrope,system-ui,sans-serif;font-size:16px;font-weight:700;border:1px solid var(--outline,#354151);border-radius:12px;min-height:48px;padding:10px 18px;display:inline-flex;align-items:center;justify-content:center;gap:10px;cursor:pointer;touch-action:manipulation;min-height:44px;padding:9px 14px;background:var(--surface,#1c222b);color:var(--ink,#f5f7fa)}.ds-pen-tools button:hover{background:var(--surface-high,#252d38)}.ds-pen-tools button[aria-pressed=true]{background:var(--cyan,#78dce8);color:#101e22;border-color:transparent}.ds-pen-tools label{display:flex;gap:9px;align-items:center;font-size:13px;min-height:44px;margin-left:auto}.ds-pen-tools input{width:20px;height:20px;accent-color:var(--cyan,#78dce8);margin:0}.ds-pen-tools button:focus-visible{outline:3px solid var(--cyan,#78dce8);outline-offset:3px}.ds-pen-tools button:disabled{opacity:.55;cursor:wait}.ds-pen-tools input:focus-visible{outline:3px solid var(--cyan,#78dce8);outline-offset:3px}"
    },
    {
      "name": "Empty scratchpad paper",
      "kind": "card",
      "refersTo": "pen-paper",
      "description": "Paper reserved for user ink; the empty hint is not a sample drawing.",
      "html": "<section class=\"ds-paper\" aria-label=\"Empty drawing surface\"><div class=\"ds-paper-hint\"><strong>Room for your next idea</strong><span>Draw with your pen. Your strokes save here.</span></div></section>",
      "css": ".ds-paper{font-family:Manrope,system-ui,sans-serif;position:relative;background:#f6f3e9;border-radius:12px;overflow:hidden;aspect-ratio:8/5;min-width:0}.ds-paper-hint{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:10px;color:#53606a;text-align:center;padding:24px}.ds-paper-hint strong{font-size:clamp(18px,2vw,26px);font-weight:650;color:#35434f}.ds-paper-hint span{font-size:14px}@media(max-width:580px){.ds-paper{border-radius:8px}.ds-paper-hint strong{font-size:17px}.ds-paper-hint span{font-size:12px}}"
    },
    {
      "name": "Windows pen input surface",
      "kind": "custom",
      "refersTo": "pen-input-pad",
      "description": "A mapped input surface with target and explicit session controls; no target-app screenshot.",
      "html": "<section class=\"ds-pen-input\"><div class=\"ds-pen-target\"><strong>Selected Windows window</strong><p>Start a pen session when your Windows app is ready.</p></div><div class=\"ds-pen-actions\"><button class=\"ds-pen-start\">Start pen session</button><button class=\"ds-pen-exit\">Fullscreen</button><button class=\"ds-pen-exit\">Back to controls</button></div><div class=\"ds-pen-stage\"><div class=\"ds-pen-pad\"><p>Your pen controls the selected Windows screen or window.</p></div></div><output>X 0% · Y 0% · Pressure 0%</output></section>",
      "css": ".ds-pen-input{font-family:Manrope,system-ui,sans-serif;display:flex;flex-direction:column;gap:16px;padding:20px 24px 24px;background:var(--canvas,#101318);color:var(--ink,#f5f7fa)}.ds-pen-target strong{display:block;font-size:15px;overflow-wrap:anywhere}.ds-pen-target p{font-size:13px;line-height:1.6;color:var(--secondary,#b8c3d1);margin:5px 0 0}.ds-pen-actions{display:flex;flex-wrap:wrap;gap:8px}.ds-pen-actions button{font-family:Manrope,system-ui,sans-serif;min-height:44px;padding:10px 16px;font-size:13px;font-weight:700;border-radius:12px;cursor:pointer;border:1px solid var(--outline,#354151)}.ds-pen-start{background:var(--cyan,#78dce8);color:#101e22;border-color:transparent!important}.ds-pen-exit{background:var(--surface,#1c222b);color:var(--ink,#f5f7fa)}.ds-pen-actions button:hover:enabled{filter:brightness(1.12)}.ds-pen-actions button:focus-visible{outline:3px solid var(--cyan,#78dce8);outline-offset:3px}.ds-pen-actions button:disabled{opacity:.5;cursor:default}.ds-pen-stage{display:flex;align-items:center;justify-content:center;min-height:260px;max-height:65vh;overflow:hidden;background:#131922;border-radius:12px}.ds-pen-pad{width:100%;aspect-ratio:8/5;position:relative;overflow:hidden;background:var(--surface,#1c222b);border:1px solid var(--outline,#354151);border-radius:12px}.ds-pen-pad p{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:28px;margin:0;text-align:center;color:var(--secondary,#b8c3d1);line-height:1.6;font-size:clamp(14px,1.5vw,18px)}.ds-pen-input output{font-size:12px;line-height:1.6;font-variant-numeric:tabular-nums;color:var(--secondary,#b8c3d1)}@media(max-width:580px){.ds-pen-input{padding:12px;gap:12px}.ds-pen-actions button{padding:10px 12px}.ds-pen-stage{min-height:220px}}"
    }
  ],
  "narrative": {
    "northStar": "A working surface beside your PC",
    "overview": "DeskWing retains the established studio interface: a near-black canvas, slate controls, bundled Manrope, authored line icons, and cyan emphasis. The direction is an extension of the working product. Large, legible controls and stable status positions support touch operation while the PC carries configuration and review.\n\nThe interface includes Stream Studio, Computer Copilot, shared Ink & notes, Pen tablet, and Second display. Each task gets a useful working area. The board editor shows the board beside its inspector; shared ink gets a quiet paper canvas; Windows pen input gets a clearly labeled target and session state; secondary Windows content gets an unobstructed view. Connection, local save, sharing, and active input state remain explicit.",
    "keyCharacteristics": [
      "Dark, compact studio surfaces with clear boundaries.",
      "One bundled type family and a small functional color vocabulary.",
      "Large tablet controls, visible focus, and labels beside state colors.",
      "Task-specific working areas with recoverable editing and readable status.",
      "Paper appears only as the surface for user-created ink."
    ],
    "rules": [
      {
        "name": "The State Has Words Rule",
        "body": "Pair connection, warning, selected, and error colors with a label, icon, outline, or explicit pressed/current state. A colored dot alone does not explain a state.",
        "section": "colors"
      },
      {
        "name": "The Working Area Rule",
        "body": "Do not add elevation, illustration, or card framing that consumes the board, inspector, drawing, or display area without helping the current task.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reuse the exact base palette, bundled Manrope, and existing authored icons.",
      "Do keep task controls near the content they affect.",
      "Do show explicit saved, selected, disabled, disconnected, and recovery states.",
      "Do preserve keyboard focus, readable labels, reduced motion, and narrow layouts.",
      "Do treat drawings, key images, and shared desktop pixels as user content."
    ],
    "donts": [
      "Don't introduce a second visual identity for editor, ink, or recovery screens.",
      "Don't use color as the only explanation of state.",
      "Don't make editor preview keys perform live actions.",
      "Don't hide save failures, draft conflicts, or source availability behind a toast alone.",
      "Don't decorate the canvas with sample ink that could be mistaken for a saved drawing.",
      "Don't visually promise full palm rejection, built-in handwriting recognition, universal drawing-app support, or a full-motion second display."
    ]
  }
}
